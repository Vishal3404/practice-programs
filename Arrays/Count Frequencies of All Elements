import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int n=in.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=in.nextInt();
        }
        Set<Integer> ob=new LinkedHashSet<Integer>();
        for(int i=0;i<n;i++){
            ob.add(a[i]);
        }
        for(int i:ob){
            int c=0;
            for(int j=0;j<n;j++){
                if(i==a[j]){
                    c++;
                }
            }
            System.out.print(i+" "+c);
            System.out.println();
        }
    }
}
