import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int n=in.nextInt();
        int a[]=new int[n];
        int r[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=in.nextInt();
        }
        int k=in.nextInt();
        if(k>n){
            k=k%n;
        }
        for(int i=0;i<n;i++){
            r[(i+k)%n]=a[i];
        }
        for(int i=0;i<n;i++){
            System.out.print(r[i]+" ");
        }
    }
}
