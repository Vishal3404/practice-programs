import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int n=in.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=in.nextInt();
        }
        int sum=0,s=0;
        for(int i=0;i<n;i++){
            int f=0;
            if(a[i]>1){
                
            for(int j=2;j<a[i];j++){
                if(a[i]!=1&&a[i]%j==0){
                    f++;
                    break;
                }
            }
            if(f==0){
                sum=sum+a[i];
                s++;
            }
        }
            }
        if(s!=0){
            System.out.print(sum);
        }
        else{
            System.out.print("No Primes");
        }
    }
}
