import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int n=in.nextInt();
        int a[]=new int[n];
        int r[]=new int[n+1];
        for(int i=0;i<n;i++){
            a[i]=in.nextInt();
        }
        int ind=in.nextInt();
        for(int i=0;i<ind;i++){
            r[i]=a[i];
        }
        r[ind]=in.nextInt();
        for(int i=ind+1;i<n+1;i++){
            r[i]=a[i-1];
        }
        for(int i=0;i<=n;i++){
            System.out.print(r[i]+" ");
        }
    }
}
