import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int  n=in.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=in.nextInt();
        }
        int t=in.nextInt();
        int l=0,m=0,sum=0;
        boolean flag=false;
        for(int i=0;i<n;i++){
            sum=0;
            for(int j=i;j<n;j++){
                sum=sum+a[j];
                if(sum==t){
                    l=i;
                    m=j+1;
                    flag=true;
                    break;
                }
            }
            if(flag==true){
                break;
            }
        }
        if(flag==true){
            for(int i=l;i<m;i++){
                System.out.print(a[i]+" ");
            }
        }
        else{
            System.out.print("No Subarray Found");
        }
    }
}
