import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int n=in.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=in.nextInt();
        }
        int m=in.nextInt();
        int b[]=new int[m];
        for(int i=0;i<m;i++){
            b[i]=in.nextInt();
        }
        int r[]=new int[n+m];
        if(n<=m){
            for(int j=0;j<n;j++){
                System.out.print(a[j]+" "+b[j]+" ");
            }
            for(int j=n;j<m;j++){
                System.out.print(b[j]+" ");
            }
        }
        else if(n>m){
            for(int i=0;i<m;i++){
                System.out.print(a[i]+" "+b[i]+" ");
            }
            for(int i=m;i<n;i++){
                System.out.print(a[i]+" ");
            }
        }
    }
}
